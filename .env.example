# Choose exactly one service-authentication mode.
MCP_MODE=standalone

# Required in standalone mode. Leave blank here; scripts/init_runtime_env.py generates it.
MCP_ACCESS_TOKEN=

# Required instead of MCP_ACCESS_TOKEN when MCP_MODE=portal.
MCP_PORTAL_GRANT_TOKEN=

# Portal mode only: the trusted broker overwrites this header with one authenticated,
# stable tenant subject on every request. The header partitions process-local approval state.
MCP_TENANT_ID_HEADER=x-madpanda-user-id

# Optional for read-only use; required to approve ordinary mutations. Keep this separate from
# agent/client credentials. The secure initializer generates a fresh operator/broker signing key.
MCP_APPROVAL_SIGNING_KEY=

# Cloudflare credentials are never stored in this file. Supply a provider token on each
# authenticated MCP request with x-cloudflare-api-token. Optional request-scoped hints use
# x-cloudflare-account-id and x-cloudflare-zone-id.

# HTTP and transport policy.
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_HOST_PORT=8000
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],cloudflare-mcp
MCP_ALLOWED_ORIGINS=
MCP_REQUEST_BODY_MAX_BYTES=131072
MCP_RESPONSE_BODY_MAX_BYTES=1048576
MCP_PROVIDER_RESPONSE_MAX_BYTES=65536

# High-risk credential, billing, commerce, account-administration, and reviewed side-effecting
# GET operations are permanently blocked from the generic dispatcher; there is no enable toggle.

# Local build defaults. Release automation replaces these with immutable provenance.
MCP_BUILD_SHA=development
MCP_SOURCE_FINGERPRINT=development
MCP_IMAGE_REFERENCE=development
MCP_IMAGE_VERSION=1.0.0

# Portal Compose only: name of the pre-existing private broker network.
MCP_PORTAL_NETWORK=mcp-network
